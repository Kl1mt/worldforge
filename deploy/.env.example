# Worldforge production settings (docs/DEPLOY.md). Copy to deploy/.env and fill in:
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# deploy/.env is git-ignored. Never commit real values. docker compose and the deploy/*.sh
# scripts read it from this directory.

# --- Domain & Cloudflare Tunnel ---------------------------------------------------------------
# The public host name players open, e.g. play.example.de. Its DNS record is created by the
# tunnel's public hostname in the Cloudflare dashboard (DEPLOY.md §6): never an A/AAAA record
# pointing at this server, or its IP becomes public.
DOMAIN=play.example.com
# Runs the `cloudflared` service. Leave as is (empty only for local tests without a tunnel).
COMPOSE_PROFILES=tunnel
# The tunnel token from the Cloudflare dashboard (the long string after `--token` in the
# install command). A secret: anyone with it can serve traffic for your hostname.
CLOUDFLARE_TUNNEL_TOKEN=
# Caddy also listens on 127.0.0.1:<this port> on the VPS itself (health checks, SSH port forward).
WEB_LOCAL_PORT=8080

# --- PostgreSQL 16 (container `db`, never exposed on a host port) ---------------------------
POSTGRES_USER=worldforge
# Generate with: openssl rand -hex 32   (hex only, so it is safe inside DATABASE_URL)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=worldforge
# How the server reaches the database. Built from the three values above; leave as is.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# Connections per API process (max_connections in docker-compose.yml is 40).
DATABASE_POOL_MAX=10

# --- Server ---------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Session lifetime from login, in hours (720 = 30 days).
SESSION_TTL_HOURS=720
# Offline progress cap after the last client contact, in seconds (GDD §9.1: 3 h).
OFFLINE_CAP_SECONDS=10800
# Scheduled settlement of idle activities, in seconds; 0 disables it.
SETTLE_INTERVAL_SECONDS=300
# Who may create an account (ticket D.2, DEPLOY.md "Registration"):
#   open   anyone            invite   only with a code from `deploy/admin.sh invite create`
#   closed nobody            Login and existing accounts and sessions work in every mode.
REGISTRATION_MODE=invite
# --- Email (ticket 5.7, DEPLOY.md "Email") ----------------------------------------------------
# Verification and password-reset letters, over SMTP with any provider (Brevo, Postmark, Amazon
# SES, Mailgun, your host's mail server, …). Leave SMTP_HOST empty to run without mail: the game
# works, and verification and password reset say "email is not set up yet".
# SMTP_HOST=smtp.example.com
SMTP_HOST=
# 587 = STARTTLS (required, never plain text); 465 = implicit TLS (SMTP_SECURE defaults to 1 there).
SMTP_PORT=587
SMTP_SECURE=
# The SMTP login from your provider. A secret: never commit it.
SMTP_USER=
SMTP_PASS=
# The sender players see; its domain must be verified at the provider (SPF/DKIM).
# MAIL_FROM=Worldforge <no-reply@play.example.com>
MAIL_FROM=
# Where links in mails point. Default: https://$DOMAIN. Set it only if players use another URL.
PUBLIC_BASE_URL=

# Fixed in docker-compose.yml, not configurable here: NODE_ENV=production, HOST=0.0.0.0,
# PORT=3000, SESSION_COOKIE_SECURE=1 (players use HTTPS), TRUST_PROXY=1 (Caddy is the only client
# and passes the player's IP from Cloudflare's CF-Connecting-IP header).

# --- Backups (deploy/backup.sh) ---------------------------------------------------------------
# Where dumps go. Relative paths are relative to deploy/. Copy them off the VPS (DEPLOY.md §10).
BACKUP_DIR=backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
