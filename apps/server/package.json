{
  "name": "@worldforge/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:pg": "vitest run src/concurrency.pg.test.ts src/social/social.pg.test.ts src/auth/invites.pg.test.ts src/social/friends.pg.test.ts src/achievements/achievements.pg.test.ts src/social/guilds.pg.test.ts src/social/guild-chat.pg.test.ts src/community/community.pg.test.ts src/guild-boss/guild-boss.pg.test.ts src/warehouse/warehouse.pg.test.ts",
    "e2e:serve": "tsx --conditions=source src/e2e/serve.ts",
    "playtest:serve": "tsx --conditions=source src/playtest/serve.ts",
    "report:telemetry": "tsx --conditions=source src/telemetry/report-cli.ts",
    "telemetry:simulate": "tsx --conditions=source src/telemetry/simulate.ts",
    "admin:role": "tsx --env-file-if-exists=.env --conditions=source src/social/role-cli.ts",
    "admin:role:prod": "node --env-file-if-exists=.env dist/social/role-cli.js",
    "admin:invite": "tsx --env-file-if-exists=.env --conditions=source src/auth/invite-cli.ts",
    "admin:invite:prod": "node --env-file-if-exists=.env dist/auth/invite-cli.js",
    "admin:project": "tsx --env-file-if-exists=.env --conditions=source src/community/project-cli.ts",
    "admin:project:prod": "node --env-file-if-exists=.env dist/community/project-cli.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --conditions=source src/db/migrate-cli.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@worldforge/game-core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
