# Copy to apps/server/.env (git-ignored). Real environments set these as env vars.
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Matches docker-compose.yml at the repo root (`pnpm db:up`).
DATABASE_URL=postgres://worldforge:worldforge@127.0.0.1:5432/worldforge
DATABASE_POOL_MAX=10
# Auth (ticket 1.2). Defaults shown.
SESSION_TTL_HOURS=720
# Browsers accept Secure cookies on http://localhost; set 0 only for plain-http hosts other than localhost.
SESSION_COOKIE_SECURE=1
# Set 1 behind a reverse proxy so rate limits see the client IP from X-Forwarded-For.
TRUST_PROXY=0
