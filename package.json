{
  "name": "worldforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @worldforge/server --filter @worldforge/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @worldforge/server db:migrate",
    "db:generate": "pnpm --filter @worldforge/server db:generate",
    "doctor": "node tools/doctor.mjs",
    "playtest": "node tools/playtest/run.mjs",
    "playtest:fast": "node tools/playtest/run.mjs --fast",
    "playtest:reset": "node tools/playtest/reset.mjs",
    "admin:role": "pnpm --silent --filter @worldforge/server admin:role",
    "report:telemetry": "pnpm --silent --filter @worldforge/server report:telemetry"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
